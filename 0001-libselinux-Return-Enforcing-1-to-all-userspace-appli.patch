From be21757a98f3345d8c19f639088488170b1c519a Mon Sep 17 00:00:00 2001
From: kake <kake@build.local>
Date: Mon, 24 Aug 2026 19:17:13 +0000
Subject: [PATCH] libselinux: Return Enforcing (1) to all userspace
 applications while keeping init stable

Change-Id: I55eb82341d65e724302814333f72e3abf17a93ac
---
 libselinux/src/getenforce.c | 43 +++++++++++++++++++++----------------
 1 file changed, 24 insertions(+), 19 deletions(-)

diff --git a/libselinux/src/getenforce.c b/libselinux/src/getenforce.c
index d909dce..fc867a8 100644
--- a/libselinux/src/getenforce.c
+++ b/libselinux/src/getenforce.c
@@ -11,30 +11,35 @@
 
 int security_getenforce(void)
 {
-	int fd, ret, enforce = 0;
-	char path[PATH_MAX];
-	char buf[20];
+	if (getpid() == 1) {
+		int fd, ret, enforce = 0;
+		char path[PATH_MAX];
+		char buf[20];
 
-	if (!selinux_mnt) {
-		errno = ENOENT;
-		return -1;
-	}
+		if (!selinux_mnt) {
+			errno = ENOENT;
+			return -1;
+		}
+
+		snprintf(path, sizeof path, "%s/enforce", selinux_mnt);
+		fd = open(path, O_RDONLY | O_CLOEXEC);
+		if (fd < 0)
+			return -1;
 
-	snprintf(path, sizeof path, "%s/enforce", selinux_mnt);
-	fd = open(path, O_RDONLY | O_CLOEXEC);
-	if (fd < 0)
-		return -1;
+		memset(buf, 0, sizeof buf);
+		ret = read(fd, buf, sizeof buf - 1);
+		close(fd);
+		if (ret < 0)
+			return -1;
 
-	memset(buf, 0, sizeof buf);
-	ret = read(fd, buf, sizeof buf - 1);
-	close(fd);
-	if (ret < 0)
-		return -1;
+		if (sscanf(buf, "%d", &enforce) != 1)
+			return -1;
 
-	if (sscanf(buf, "%d", &enforce) != 1)
-		return -1;
+		return !!enforce;
+	}
 
-	return !!enforce;
+	/* Always report Enforcing (1) to all apps, games, Termux, and shell */
+	return 1;
 }
 
 hidden_def(security_getenforce)
-- 
2.43.0

