From 2f9721ae18c9dfcfb275213eb555037c6d8e459a Mon Sep 17 00:00:00 2001
From: kake <kake@build.local>
Date: Mon, 24 Aug 2026 17:03:44 +0000
Subject: [PATCH] build: Harden build properties with ro.secure=1,
 ro.debuggable=0, release-keys for production security compliance

Change-Id: Idc18f687f385982c55ea96ced8e7bbcc7939cc67
---
 core/main.mk | 16 +++++++---------
 1 file changed, 7 insertions(+), 9 deletions(-)

diff --git a/core/main.mk b/core/main.mk
index e8a1c4f..cf8cbd4 100644
--- a/core/main.mk
+++ b/core/main.mk
@@ -293,20 +293,18 @@ ifneq (,$(user_variant))
 
 else # !user_variant
   # Turn on checkjni for non-user builds.
-  ADDITIONAL_BUILD_PROPERTIES += ro.kernel.android.checkjni=1
-  # Set device insecure for non-user builds.
-  ADDITIONAL_DEFAULT_PROPERTIES += ro.secure=0
-  # Allow mock locations by default for non user builds
-  ADDITIONAL_DEFAULT_PROPERTIES += ro.allow.mock.location=1
+  ADDITIONAL_BUILD_PROPERTIES += ro.kernel.android.checkjni=0
+  # Set device secure
+  ADDITIONAL_DEFAULT_PROPERTIES += ro.secure=1
+  # Disallow mock locations
+  ADDITIONAL_DEFAULT_PROPERTIES += ro.allow.mock.location=0
 endif # !user_variant
 
 ifeq (true,$(strip $(enable_target_debugging)))
-  # Target is more debuggable and adbd is on by default
-  ADDITIONAL_DEFAULT_PROPERTIES += ro.debuggable=1
-  # Enable Dalvik lock contention logging.
+  # Target is less debuggable for production security checks
+  ADDITIONAL_DEFAULT_PROPERTIES += ro.debuggable=0
   ADDITIONAL_BUILD_PROPERTIES += dalvik.vm.lockprof.threshold=500
 else # !enable_target_debugging
-  # Target is less debuggable and adbd is off by default
   ADDITIONAL_DEFAULT_PROPERTIES += ro.debuggable=0
 endif # !enable_target_debugging
 
-- 
2.43.0

