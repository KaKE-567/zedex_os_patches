From 835a022e068a746801c3500168fe54e254d7d60b Mon Sep 17 00:00:00 2001
From: kake <kake@build.local>
Date: Tue, 25 Aug 2026 04:51:38 +0000
Subject: [PATCH 15/28] QuickQSPanel: Enforce mRows=2 and mColumns=2 across all
 lifecycle stages

Change-Id: Id537ffbc7f468133c980189a2b08b6253a6a78e9
---
 .../src/com/android/systemui/qs/QuickQSPanel.java      | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java b/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
index d0a945f2..1bf84aaa 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
@@ -201,6 +201,9 @@ public class QuickQSPanel extends QSPanel {
             super(context);
             setClipChildren(false);
             setClipToPadding(false);
+            mColumns = NUM_COLUMNS;
+            mRows = NUM_ROWS;
+            mMaxAllowedRows = NUM_ROWS;
             LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                     LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);
             setLayoutParams(lp);
@@ -216,6 +219,7 @@ public class QuickQSPanel extends QSPanel {
         public boolean updateResources() {
             super.updateResources();
             mColumns = NUM_COLUMNS;
+            mRows = NUM_ROWS;
             mMaxAllowedRows = NUM_ROWS;
             mCellMarginTop = 0;
             return false;
@@ -223,15 +227,17 @@ public class QuickQSPanel extends QSPanel {
 
         @Override
         protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
-            // Force UNSPECIFIED so parent calculates mRows = ceil(tiles / 2) = 2
-            // This is the key fix: pass UNSPECIFIED so parent sets mRows = (4+2-1)/2 = 2
             mColumns = NUM_COLUMNS;
+            mRows = NUM_ROWS;
             super.onMeasure(widthMeasureSpec,
                     MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED));
+            mRows = NUM_ROWS;
         }
 
         @Override
         protected void onLayout(boolean changed, int l, int t, int r, int b) {
+            mColumns = NUM_COLUMNS;
+            mRows = NUM_ROWS;
             // Clip right side
             mClippingBounds.set(0, 0, r - l, 10000);
             setClipBounds(mClippingBounds);
-- 
