From: kake <kake@build.local>
Date: Wed, 26 Aug 2026 08:36:26 +0000
Subject: [PATCH 10/10] UI: Implement ultra-relaxing, fluid, lag-free app
 transition animations

Change-Id: Ibd24bcf6a0c68a179ab1eb3717d5fb5f8313ff28
---
 core/res/res/anim/activity_close_enter.xml | 22 ++++++------------
 core/res/res/anim/activity_close_exit.xml  | 24 ++++++++++++++-----
 core/res/res/anim/activity_open_enter.xml  | 27 ++++++++++++++++------
 core/res/res/anim/activity_open_exit.xml   | 23 +++++++-----------
 4 files changed, 53 insertions(+), 43 deletions(-)

diff --git a/core/res/res/anim/activity_close_enter.xml b/core/res/res/anim/activity_close_enter.xml
index 47a2aed0..db49f6bc 100644
--- a/core/res/res/anim/activity_close_enter.xml
+++ b/core/res/res/anim/activity_close_enter.xml
@@ -20,31 +20,23 @@
 <set xmlns:android="http://schemas.android.com/apk/res/android"
     android:shareInterpolator="false">
     <alpha
-        android:fromAlpha="0.7"
+        android:fromAlpha="0.8"
         android:toAlpha="1.0"
         android:fillEnabled="true"
         android:fillBefore="true"
         android:fillAfter="true"
-        android:interpolator="@interpolator/linear"
-        android:duration="240"/>
-    <translate
-        android:fromXDelta="-8%"
-        android:toXDelta="0"
-        android:fillEnabled="true"
-        android:fillBefore="true"
-        android:fillAfter="true"
-        android:interpolator="@interpolator/aggressive_ease"
-        android:duration="300"/>
+        android:interpolator="@interpolator/decelerate_cubic"
+        android:duration="280"/>
     <scale
-        android:fromXScale="0.96"
+        android:fromXScale="0.97"
         android:toXScale="1.0"
-        android:fromYScale="0.96"
+        android:fromYScale="0.97"
         android:toYScale="1.0"
         android:pivotX="50%"
         android:pivotY="50%"
         android:fillEnabled="true"
         android:fillBefore="true"
         android:fillAfter="true"
-        android:interpolator="@interpolator/aggressive_ease"
-        android:duration="300"/>
+        android:interpolator="@interpolator/fast_out_extra_slow_in"
+        android:duration="320"/>
 </set>
\ No newline at end of file
diff --git a/core/res/res/anim/activity_close_exit.xml b/core/res/res/anim/activity_close_exit.xml
index 5b282cfd..8c4eebe9 100644
--- a/core/res/res/anim/activity_close_exit.xml
+++ b/core/res/res/anim/activity_close_exit.xml
@@ -26,14 +26,26 @@
         android:fillEnabled="true"
         android:fillBefore="true"
         android:fillAfter="true"
-        android:interpolator="@interpolator/linear"
-        android:duration="240"/>
+        android:interpolator="@interpolator/decelerate_cubic"
+        android:duration="280"/>
     <translate
-        android:fromXDelta="0"
-        android:toXDelta="20%"
+        android:fromYDelta="0"
+        android:toYDelta="5%"
         android:fillEnabled="true"
         android:fillBefore="true"
         android:fillAfter="true"
-        android:interpolator="@interpolator/aggressive_ease"
-        android:duration="300"/>
+        android:interpolator="@interpolator/fast_out_extra_slow_in"
+        android:duration="320"/>
+    <scale
+        android:fromXScale="1.0"
+        android:toXScale="0.95"
+        android:fromYScale="1.0"
+        android:toYScale="0.95"
+        android:pivotX="50%"
+        android:pivotY="50%"
+        android:fillEnabled="true"
+        android:fillBefore="true"
+        android:fillAfter="true"
+        android:interpolator="@interpolator/fast_out_extra_slow_in"
+        android:duration="320"/>
 </set>
