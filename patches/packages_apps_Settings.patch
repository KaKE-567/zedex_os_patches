+
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.util.Log;
+import android.widget.Toast;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+import java.io.FileOutputStream;
+import java.io.IOException;
+
+public class ZedexPerformanceProfilePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    public static final String KEY_PERF_PROFILE = "zedex_perf_profile";
+    private static final String TAG = "ZedexPerfController";
+
+    public static final String PROFILE_GAMING = "gaming";
+    public static final String PROFILE_BENCHMARK = "benchmark";
+    public static final String PROFILE_BALANCED = "balanced";
+    public static final String PROFILE_BATTERY = "battery";
+
+    public ZedexPerformanceProfilePreferenceController(Context context) {
+        super(context, KEY_PERF_PROFILE);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof ListPreference) {
+            ListPreference listPref = (ListPreference) preference;
+            String currentProfile = Settings.System.getString(
+                    mContext.getContentResolver(), KEY_PERF_PROFILE);
+            if (currentProfile == null) {
+                currentProfile = PROFILE_GAMING;
+            }
+            listPref.setValue(currentProfile);
+            updateSummary(listPref, currentProfile);
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        String profile = (String) newValue;
+        Settings.System.putString(mContext.getContentResolver(), KEY_PERF_PROFILE, profile);
+        applyProfile(profile);
+
+        if (preference instanceof ListPreference) {
+            ListPreference listPref = (ListPreference) preference;
+            listPref.setValue(profile);
+            updateSummary(listPref, profile);
+        }
+
+        String toastMsg = "Profile Switched: " + getProfileName(profile);
+        Toast.makeText(mContext, toastMsg, Toast.LENGTH_SHORT).show();
+        return true;
+    }
+
+    private void updateSummary(ListPreference listPref, String profile) {
+        switch (profile) {
+            case PROFILE_GAMING:
+                listPref.setSummary("🎮 Gaming Mode — 2.32 GHz Max Boost, 95°C Thermal Ceiling, 0μs Ramp");
+                break;
+            case PROFILE_BENCHMARK:
+                listPref.setSummary("🚀 Benchmark Overdrive — 8 Cores Locked Max, SchedTune Boost 25");
+                break;
+            case PROFILE_BATTERY:
+                listPref.setSummary("🔋 Battery Saver — Capped 1.4 GHz, Max Power Efficiency");
+                break;
+            case PROFILE_BALANCED:
+            default:
+                listPref.setSummary("⚖️ Balanced — Intelligent Dynamic Frequency Scaling");
+                break;
+        }
+    }
+
+    private String getProfileName(String profile) {
+        switch (profile) {
+            case PROFILE_GAMING:
+                return "🎮 Gaming Mode";
+            case PROFILE_BENCHMARK:
+                return "🚀 Benchmark Overdrive";
+            case PROFILE_BATTERY:
+                return "🔋 Battery Saver";
+            case PROFILE_BALANCED:
+            default:
+                return "⚖️ Balanced";
+        }
+    }
+
+    public static void applyProfile(String profile) {
+        try {
+            android.os.SystemProperties.set("persist.sys.perf_profile", profile);
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to set persist.sys.perf_profile property: " + profile, e);
+        }
+        try {
+            switch (profile) {
+                case PROFILE_GAMING:
+                    // Big cores instant max clock 2.32 GHz
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_freq", "2323200");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_load", "50");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/up_rate_limit_us", "0");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/down_rate_limit_us", "20000");
+                    writeSysfs("/sys/devices/system/cpu/cpu6/sched_load_boost", "15");
+                    writeSysfs("/sys/devices/system/cpu/cpu7/sched_load_boost", "15");
+
+                    // Little cores 1.8 GHz
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq", "1804800");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load", "50");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us", "0");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us", "20000");
+
+                    // SchedTune Top-App Boost
+                    writeSysfs("/dev/stune/top-app/schedtune.boost", "15");
+                    writeSysfs("/dev/stune/top-app/schedtune.prefer_idle", "1");
+                    writeSysfs("/dev/stune/top-app/schedtune.colocate", "1");
+
+                    // Gaming Thermal Profile
+                    writeSysfs("/sys/class/thermal/thermal_message/sconfig", "10");
+                    break;
+
+                case PROFILE_BENCHMARK:
+                    // Benchmark Overdrive - Locked maximum frequencies
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_freq", "2323200");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_load", "30");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/up_rate_limit_us", "0");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/down_rate_limit_us", "50000");
+                    writeSysfs("/sys/devices/system/cpu/cpu6/sched_load_boost", "25");
+                    writeSysfs("/sys/devices/system/cpu/cpu7/sched_load_boost", "25");
+
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq", "1804800");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load", "30");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us", "0");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us", "50000");
+
+                    writeSysfs("/dev/stune/top-app/schedtune.boost", "25");
+                    writeSysfs("/dev/stune/top-app/schedtune.prefer_idle", "1");
+                    writeSysfs("/dev/stune/top-app/schedtune.colocate", "1");
+
+                    writeSysfs("/sys/class/thermal/thermal_message/sconfig", "10");
+                    break;
+
+                case PROFILE_BATTERY:
+                    // Battery Saver - Capped CPU frequencies
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_freq", "1401600");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_load", "85");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/up_rate_limit_us", "2000");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/down_rate_limit_us", "5000");
+                    writeSysfs("/sys/devices/system/cpu/cpu6/sched_load_boost", "-10");
+                    writeSysfs("/sys/devices/system/cpu/cpu7/sched_load_boost", "-10");
+
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq", "1248000");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load", "85");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us", "2000");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us", "5000");
+
+                    writeSysfs("/dev/stune/top-app/schedtune.boost", "0");
+                    writeSysfs("/dev/stune/top-app/schedtune.prefer_idle", "0");
+                    writeSysfs("/dev/stune/top-app/schedtune.colocate", "0");
+
+                    writeSysfs("/sys/class/thermal/thermal_message/sconfig", "1");
+                    break;
+
+                case PROFILE_BALANCED:
+                default:
+                    // Balanced Profile
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_freq", "1804800");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/hispeed_load", "70");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/up_rate_limit_us", "500");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy6/schedutil/down_rate_limit_us", "20000");
+                    writeSysfs("/sys/devices/system/cpu/cpu6/sched_load_boost", "0");
+                    writeSysfs("/sys/devices/system/cpu/cpu7/sched_load_boost", "0");
+
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq", "1401600");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_load", "70");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us", "500");
+                    writeSysfs("/sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us", "20000");
+
+                    writeSysfs("/dev/stune/top-app/schedtune.boost", "5");
+                    writeSysfs("/dev/stune/top-app/schedtune.prefer_idle", "1");
+                    writeSysfs("/dev/stune/top-app/schedtune.colocate", "1");
+
+                    writeSysfs("/sys/class/thermal/thermal_message/sconfig", "0");
+                    break;
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Failed to apply profile: " + profile, e);
+        }
+    }
+
+    private static void writeSysfs(String path, String value) {
+        try (FileOutputStream fos = new FileOutputStream(path)) {
+            fos.write(value.getBytes());
+            fos.flush();
+        } catch (IOException e) {
+            // Node might not exist or permission denied
+        }
+    }
+}
