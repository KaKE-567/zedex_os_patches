@@ -0,0 +1,120 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Copyright (C) 2026 The Zedex OS Project
+  -->
+
+<PreferenceScreen
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:settings="http://schemas.android.com/apk/res-auto"
+    android:key="gaming_mode_settings_screen"
+    android:title="Zedex Gaming Space">
+
+    <PreferenceCategory
+        android:key="gaming_mode_main_category"
+        android:title="Master Controls">
+
+        <SwitchPreference
+            android:key="gaming_mode_toggle"
+            android:title="Enable Game Mode"
+            android:summary="Manually turn on Gaming Mode features right now"
+            android:defaultValue="false"
+            settings:controller="com.android.settings.gaming.GamingModeTogglePreferenceController" />
+
+        <com.android.settings.gaming.GamingModeAppListPreference
+            android:key="gaming_mode_app_list"
+            android:title="Add Games"
+            android:dialogTitle="Select Games &amp; Apps for Game Mode"
+            android:summary="Choose installed games to automatically activate Game Mode on launch" />
+
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="gaming_notification_category"
+        android:title="In-Game Notifications">
+
+        <SwitchPreference
+            android:key="gaming_mode_danmaku"
+            android:title="Danmaku Bullet Notifications"
+            android:summary="Display incoming messages as lightweight subtitle tickers instead of blocking cards"
+            android:defaultValue="true"
+            settings:controller="com.android.settings.gaming.GamingModeGenericSwitchController" />
+
+        <SwitchPreference
+            android:key="gaming_mode_block_heads_up"
+            android:title="Suppress Notification Banners"
+            android:summary="Completely block large heads-up banner popups during gameplay"
+            android:defaultValue="true"
+            settings:controller="com.android.settings.gaming.GamingModeGenericSwitchController" />
+
+        <SwitchPreference
+            android:key="gaming_mode_disable_ringer"
+            android:title="Mute Ringtone &amp; Notification Audio"
+            android:summary="Silence incoming calls and alerts so game footsteps and voice chat stay clear"
+            android:defaultValue="false"
+            settings:controller="com.android.settings.gaming.GamingModeGenericSwitchController" />
+
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="gaming_controls_category"
+        android:title="Controls &amp; Display">
+
+        <SwitchPreference
+            android:key="gaming_mode_lock_gestures"
+            android:title="Lock Back Gestures &amp; Navigation Bar"
+            android:summary="Prevent accidental exits during 3/4-finger claw grip aiming"
+            android:defaultValue="true"
+            settings:controller="com.android.settings.gaming.GamingModeGenericSwitchController" />
+
+        <SwitchPreference
+            android:key="gaming_mode_lock_brightness"
+            android:title="Lock Screen Brightness"
+            android:summary="Prevent auto-brightness from dimming the screen during gaming"
+            android:defaultValue="false"
+            settings:controller="com.android.settings.gaming.GamingModeGenericSwitchController" />
+
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="gaming_performance_category"
+        android:title="Performance Engine">
+
+        <ListPreference
+            android:key="zedex_perf_profile"
+            android:title="@string/zedex_perf_profile_title"
+            android:summary="%s"
+            android:entries="@array/zedex_perf_profile_entries"
+            android:entryValues="@array/zedex_perf_profile_values"
+            android:defaultValue="gaming"
+            settings:controller="com.android.settings.fuelgauge.ZedexPerformanceProfilePreferenceController" />
+
+        <Preference
+            android:key="game_spoofing_info"
+            android:title="90 FPS + HDR Game Spoofing"
+            android:summary="Xiaomi Redmi K30 Ultra (M2006J10C) — Active for PUBG, BGMI &amp; CODM"
+            android:selectable="false" />
+
+        <Preference
+            android:key="game_engine_info"
+            android:title="Zero-Throttle Performance Engine"
+            android:summary="2.32 GHz Kryo Boost, 0μs Governor Ramp, 95°C Thermal Headroom &amp; 8-Thread ART JIT"
+            android:selectable="false" />
+
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="gaming_maintainer_category"
+        android:title="Developer &amp; Support">
+
+        <Preference
+            android:key="zedex_maintainer_link"
+            android:title="Zedex Maintainer"
+            android:summary="@Xx_KaKe_xX (Tap to open Telegram)"
+            settings:allowDividerAbove="true">
+            <intent android:action="android.intent.action.VIEW"
+                    android:data="https://t.me/Xx_KaKe_xX" />
+        </Preference>
+
+    </PreferenceCategory>
+
+</PreferenceScreen>
