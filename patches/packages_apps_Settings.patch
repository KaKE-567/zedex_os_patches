+package com.android.settings.gaming;
+
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.provider.Settings;
+import android.util.AttributeSet;
+
+import androidx.preference.MultiSelectListPreference;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+public class GamingModeAppListPreference extends MultiSelectListPreference {
+
+    public GamingModeAppListPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        loadInstalledApps();
+    }
+
+    public GamingModeAppListPreference(Context context) {
+        super(context);
+        loadInstalledApps();
+    }
+
+    private void loadInstalledApps() {
+        Context context = getContext();
+        PackageManager pm = context.getPackageManager();
+        List<ApplicationInfo> apps = pm.getInstalledApplications(PackageManager.GET_META_DATA);
+
+        List<AppItem> appList = new ArrayList<>();
+        for (ApplicationInfo info : apps) {
+            if (pm.getLaunchIntentForPackage(info.packageName) != null) {
+                String label = info.loadLabel(pm).toString();
+                appList.add(new AppItem(label, info.packageName));
+            }
+        }
+
+        Collections.sort(appList, Comparator.comparing(a -> a.label.toLowerCase()));
+
+        CharSequence[] entries = new CharSequence[appList.size()];
+        CharSequence[] entryValues = new CharSequence[appList.size()];
+
+        for (int i = 0; i < appList.size(); i++) {
+            entries[i] = appList.get(i).label;
+            entryValues[i] = appList.get(i).packageName;
+        }
+
+        setEntries(entries);
+        setEntryValues(entryValues);
+
+        // Load saved values from Settings.System
+        String savedString = Settings.System.getString(context.getContentResolver(), "gaming_mode_app_list");
+        Set<String> savedSet = new HashSet<>();
+        if (savedString != null && !savedString.isEmpty()) {
+            String[] pkgs = savedString.split(";");
+            Collections.addAll(savedSet, pkgs);
+        }
+        setValues(savedSet);
+        updateSummary(savedSet);
+
+        setOnPreferenceChangeListener((preference, newValue) -> {
+            @SuppressWarnings("unchecked")
+            Set<String> newSet = (Set<String>) newValue;
+            StringBuilder sb = new StringBuilder();
+            for (String pkg : newSet) {
+                if (sb.length() > 0) sb.append(";");
+                sb.append(pkg);
+            }
+            Settings.System.putString(context.getContentResolver(), "gaming_mode_app_list", sb.toString());
+            updateSummary(newSet);
+            return true;
+        });
+    }
+
+    private void updateSummary(Set<String> set) {
+        if (set == null || set.isEmpty()) {
+            setSummary("No games configured (Tap to add games)");
+        } else {
+            setSummary(set.size() + " game(s) configured for automatic Game Mode");
+        }
+    }
+
+    private static class AppItem {
+        final String label;
+        final String packageName;
+
+        AppItem(String label, String packageName) {
+            this.label = label;
+            this.packageName = packageName;
+        }
+    }
+}
