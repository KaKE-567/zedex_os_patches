+package com.android.settings.gaming;
+
+import android.content.Context;
+import android.provider.Settings;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreference;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settings.fuelgauge.ZedexPerformanceProfilePreferenceController;
+
+public class GamingModeTogglePreferenceController extends BasePreferenceController
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String KEY_GAMING_MODE = "gaming_mode_toggle";
+
+    public GamingModeTogglePreferenceController(Context context) {
+        super(context, KEY_GAMING_MODE);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        if (preference instanceof SwitchPreference) {
+            boolean active = Settings.System.getInt(
+                    mContext.getContentResolver(), "gaming_mode_active", 0) == 1;
+            ((SwitchPreference) preference).setChecked(active);
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean enabled = (Boolean) newValue;
+        Settings.System.putInt(mContext.getContentResolver(), "gaming_mode_active", enabled ? 1 : 0);
+
+        if (enabled) {
+            ZedexPerformanceProfilePreferenceController.applyProfile(
+                    ZedexPerformanceProfilePreferenceController.PROFILE_GAMING);
+            Settings.System.putString(mContext.getContentResolver(),
+                    ZedexPerformanceProfilePreferenceController.KEY_PERF_PROFILE,
+                    ZedexPerformanceProfilePreferenceController.PROFILE_GAMING);
+            Toast.makeText(mContext, "🎮 Gaming Mode ON (Navigation & Notifications Locked)", Toast.LENGTH_SHORT).show();
+        } else {
+            Toast.makeText(mContext, "Gaming Mode OFF", Toast.LENGTH_SHORT).show();
+        }
+
+        if (preference instanceof SwitchPreference) {
+            ((SwitchPreference) preference).setChecked(enabled);
+        }
+        return true;
+    }
+}
