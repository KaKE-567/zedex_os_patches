From aa46ddde93df6958fcaccac4f46a1d123474fa63 Mon Sep 17 00:00:00 2001
From: kake <kake@build.local>
Date: Mon, 24 Aug 2026 20:08:22 +0000
Subject: [PATCH 13/34] SystemUI: Initialize mMaxTiles=4 in QuickQSPanel and
 fix label marquee overlap glitch

Change-Id: I8d7d46f4c3e5d44c44b147e153fb018c99ba46d2
---
 packages/SystemUI/res/layout/qs_tile_label.xml       |  6 +++---
 .../src/com/android/systemui/qs/QuickQSPanel.java    | 12 +++++++-----
 2 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/packages/SystemUI/res/layout/qs_tile_label.xml b/packages/SystemUI/res/layout/qs_tile_label.xml
index f95c7ae5..695303cd 100644
--- a/packages/SystemUI/res/layout/qs_tile_label.xml
+++ b/packages/SystemUI/res/layout/qs_tile_label.xml
@@ -42,13 +42,13 @@
 
         <TextView
             android:id="@+id/tile_label"
-            android:layout_width="wrap_content"
+            android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:clickable="false"
             android:padding="0dp"
             android:gravity="start|center_vertical"
             android:singleLine="true"
-            android:ellipsize="marquee"
+            android:ellipsize="end"
             android:textStyle="bold"
             android:textSize="13.5sp"
             android:textAppearance="@style/TextAppearance.QS.TileLabel"/>
@@ -77,7 +77,7 @@
         android:layout_height="wrap_content"
         android:layout_below="@id/label_group"
         android:clickable="false"
-        android:ellipsize="marquee"
+        android:ellipsize="end"
         android:singleLine="true"
         android:padding="0dp"
         android:visibility="gone"
diff --git a/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java b/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
index 3b476824..d0a945f2 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
@@ -51,8 +51,8 @@ public class QuickQSPanel extends QSPanel {
     private static final String TAG = "QuickQSPanel";
 
     private boolean mDisabledByPolicy;
-    private static int mDefaultMaxTiles;
-    private int mMaxTiles;
+    private static int mDefaultMaxTiles = 4;
+    private int mMaxTiles = 4;
     protected QSPanel mFullPanel;
 
     @Inject
@@ -68,7 +68,8 @@ public class QuickQSPanel extends QSPanel {
             }
             removeView((View) mTileLayout);
         }
-        mDefaultMaxTiles = getResources().getInteger(R.integer.quick_qs_panel_max_columns);
+        mDefaultMaxTiles = 4;
+        mMaxTiles = 4;
         mTileLayout = new HeaderTileLayout(context);
         mTileLayout.setListening(mListening);
         addView((View) mTileLayout, 0 /* Between brightness and footer */);
@@ -125,7 +126,7 @@ public class QuickQSPanel extends QSPanel {
     }
 
     public void setMaxTiles(int maxTiles) {
-        mMaxTiles = maxTiles;
+        mMaxTiles = maxTiles > 0 ? maxTiles : 4;
         if (mHost != null) {
             setTiles(mHost.getTiles());
         }
@@ -142,9 +143,10 @@ public class QuickQSPanel extends QSPanel {
     @Override
     public void setTiles(Collection<QSTile> tiles) {
         ArrayList<QSTile> quickTiles = new ArrayList<>();
+        int targetMax = mMaxTiles > 0 ? mMaxTiles : 4;
         for (QSTile tile : tiles) {
             quickTiles.add(tile);
-            if (quickTiles.size() == mMaxTiles) {
+            if (quickTiles.size() == targetMax) {
                 break;
             }
         }
-- 
2.43.0

