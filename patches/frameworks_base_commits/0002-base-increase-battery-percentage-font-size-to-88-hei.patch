From 89efc8bb7b7d78ef7b0aa988a67c4016e23a27ab Mon Sep 17 00:00:00 2001
From: kake <kake@build.local>
Date: Mon, 24 Aug 2026 12:59:01 +0000
Subject: [PATCH 02/29] base: increase battery percentage font size to 88%
 height and adjust capsule corner radius

Change-Id: Ib29ce2a502669381261f011c33fec09f5729cc50
---
 .../settingslib/graph/ThemedBatteryDrawable.kt  | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/packages/SettingsLib/src/com/android/settingslib/graph/ThemedBatteryDrawable.kt b/packages/SettingsLib/src/com/android/settingslib/graph/ThemedBatteryDrawable.kt
index 102d9ac8..306e2dbd 100644
--- a/packages/SettingsLib/src/com/android/settingslib/graph/ThemedBatteryDrawable.kt
+++ b/packages/SettingsLib/src/com/android/settingslib/graph/ThemedBatteryDrawable.kt
@@ -31,7 +31,7 @@ import com.android.settingslib.R
 import com.android.settingslib.Utils
 
 /**
- * Pixel-Perfect iOS 16/17/27 Battery Meter Drawable with Dual-Contrast Inbuilt Percentage
+ * Pixel-Perfect iOS 16/17/27 Battery Meter Drawable with Large Bold Dual-Contrast Percentage
  */
 open class ThemedBatteryDrawable(private val context: Context, frameColor: Int) : Drawable() {
 
@@ -134,12 +134,12 @@ open class ThemedBatteryDrawable(private val context: Context, frameColor: Int)
         val width = b.width().toFloat()
         val height = b.height().toFloat()
 
-        // 1. Calculate Frame geometry
-        val cornerRadius = height * 0.36f
-        val terminalWidth = width * 0.055f
+        // 1. Calculate Frame geometry - Sleek modern iOS capsule (radius = 0.28 * height)
+        val cornerRadius = height * 0.28f
+        val terminalWidth = width * 0.05f
         val terminalHeight = height * 0.38f
 
-        val mainWidth = width - terminalWidth - 1.5f
+        val mainWidth = width - terminalWidth - 1.2f
         outerFrame.set(
             b.left.toFloat(),
             b.top.toFloat(),
@@ -207,7 +207,7 @@ open class ThemedBatteryDrawable(private val context: Context, frameColor: Int)
             val boltH = height * 0.62f
             val numStr = batteryLevel.toString()
 
-            textPaint.textSize = height * 0.64f
+            textPaint.textSize = height * 0.65f
             val textWidth = textPaint.measureText(numStr)
             val spacing = width * 0.035f
             val totalContentWidth = boltW + spacing + textWidth
@@ -236,7 +236,8 @@ open class ThemedBatteryDrawable(private val context: Context, frameColor: Int)
             c.drawText(numStr, textCenterX, baseline, textPaint)
         } else if (showPercent && batteryLevel in 1..100) {
             val numStr = batteryLevel.toString()
-            textPaint.textSize = height * 0.68f
+            // Large bold font: 88% height for 1-2 digits, 72% for 100
+            textPaint.textSize = if (batteryLevel == 100) height * 0.72f else height * 0.88f
             val fontMetrics = textPaint.fontMetrics
             val baseline = centerY - (fontMetrics.ascent + fontMetrics.descent) / 2f
 
@@ -317,7 +318,7 @@ open class ThemedBatteryDrawable(private val context: Context, frameColor: Int)
 
     companion object {
         private const val TAG = "ThemedBatteryDrawable"
-        private const val WIDTH = 28f
+        private const val WIDTH = 27f
         private const val HEIGHT = 13.5f
         private const val CRITICAL_LEVEL = 20
     }
