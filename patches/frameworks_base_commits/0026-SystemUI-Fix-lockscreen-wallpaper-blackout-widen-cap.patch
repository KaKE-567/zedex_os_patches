diff --git a/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java b/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
index 1bf84aaa..30bc8b83 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/QuickQSPanel.java
@@ -193,22 +193,30 @@ public class QuickQSPanel extends QSPanel {
         private boolean mListening;
         private Rect mClippingBounds = new Rect();
 
-        // Fixed 2x2 grid: 2 columns, 2 rows = 4 tiles
-        private static final int NUM_COLUMNS = 2;
-        private static final int NUM_ROWS = 2;
-
         public HeaderTileLayout(Context context) {
             super(context);
             setClipChildren(false);
             setClipToPadding(false);
-            mColumns = NUM_COLUMNS;
-            mRows = NUM_ROWS;
-            mMaxAllowedRows = NUM_ROWS;
+            updateGridDimensions();
             LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                     LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);
             setLayoutParams(lp);
         }
 
+        private int getNumColumns() {
+            return getResources().getConfiguration().orientation == Configuration.ORIENTATION_LANDSCAPE ? 4 : 2;
+        }
+
+        private int getNumRows() {
+            return getResources().getConfiguration().orientation == Configuration.ORIENTATION_LANDSCAPE ? 1 : 2;
+        }
+
+        private void updateGridDimensions() {
+            mColumns = getNumColumns();
+            mRows = getNumRows();
+            mMaxAllowedRows = mRows;
+        }
+
         @Override
         protected void onConfigurationChanged(Configuration newConfig) {
             super.onConfigurationChanged(newConfig);
@@ -218,41 +226,38 @@ public class QuickQSPanel extends QSPanel {
         @Override
         public boolean updateResources() {
             super.updateResources();
-            mColumns = NUM_COLUMNS;
-            mRows = NUM_ROWS;
-            mMaxAllowedRows = NUM_ROWS;
+            updateGridDimensions();
             mCellMarginTop = 0;
             return false;
         }
 
         @Override
         protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
-            mColumns = NUM_COLUMNS;
-            mRows = NUM_ROWS;
+            updateGridDimensions();
             super.onMeasure(widthMeasureSpec,
                     MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED));
-            mRows = NUM_ROWS;
+            mRows = getNumRows();
         }
 
         @Override
         protected void onLayout(boolean changed, int l, int t, int r, int b) {
-            mColumns = NUM_COLUMNS;
-            mRows = NUM_ROWS;
+            updateGridDimensions();
             // Clip right side
             mClippingBounds.set(0, 0, r - l, 10000);
             setClipBounds(mClippingBounds);
 
-            // Show 4 tiles (2x2), hide the rest
+            // Show 4 tiles (2x2 in portrait, 4x1 in landscape), hide the rest
+            final int maxTiles = mColumns * mRows;
             for (int i = 0; i < mRecords.size(); i++) {
                 mRecords.get(i).tileView.setVisibility(
-                        i < (NUM_COLUMNS * NUM_ROWS) ? View.VISIBLE : View.GONE);
+                        i < maxTiles ? View.VISIBLE : View.GONE);
             }
-            layoutTileRecords(NUM_COLUMNS * NUM_ROWS);
+            layoutTileRecords(maxTiles);
         }
 
         @Override
         public int getNumVisibleTiles() {
-            return Math.min(mRecords.size(), NUM_COLUMNS * NUM_ROWS);
+            return Math.min(mRecords.size(), mColumns * mRows);
         }
     }
 }
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
index 1097dc0b..2a321400 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
@@ -458,12 +458,21 @@ public class ScrimController implements ViewTreeObserver.OnPreDrawListener, OnCo
             mCurrentBehindTint = Color.BLACK;
             mCurrentInFrontAlpha = 0;
         } else if (mState == ScrimState.KEYGUARD || mState == ScrimState.PULSING) {
-            // Darken scrim to solid black as you pull down the shade on keyguard
+            // Either darken of make the scrim transparent when you
+            // pull down the shade
             float interpolatedFract = getInterpolatedFraction();
-            interpolatedFract = (float) Math.pow(interpolatedFract, 0.8f);
-            mCurrentBehindAlpha = interpolatedFract * 1.0f;
-            mCurrentBehindTint = Color.BLACK;
-            mCurrentInFrontAlpha = mState.getFrontAlpha();
+            float alphaBehind = mState.getBehindAlpha();
+            if (mDarkenWhileDragging) {
+                mCurrentBehindAlpha = MathUtils.lerp(GRADIENT_SCRIM_ALPHA_BUSY, alphaBehind,
+                        interpolatedFract);
+                mCurrentInFrontAlpha = mState.getFrontAlpha();
+            } else {
+                mCurrentBehindAlpha = MathUtils.lerp(0 /* start */, alphaBehind,
+                        interpolatedFract);
+                mCurrentInFrontAlpha = mState.getFrontAlpha();
+            }
+            mCurrentBehindTint = ColorUtils.blendARGB(ScrimState.BOUNCER.getBehindTint(),
+                    mState.getBehindTint(), interpolatedFract);
         }
         if (isNaN(mCurrentBehindAlpha) || isNaN(mCurrentInFrontAlpha)) {
             throw new IllegalStateException("Scrim opacity is NaN for state: " + mState
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
index 84f5128e..f6404389 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
@@ -55,7 +55,7 @@ public enum ScrimState {
             }
             mCurrentInFrontTint = Color.BLACK;
             mCurrentBehindTint = Color.BLACK;
-            mCurrentBehindAlpha = 0f;
+            mCurrentBehindAlpha = mScrimBehindAlphaKeyguard;
             mCurrentInFrontAlpha = 0;
         }
     },
