Subject: [PATCH 18/29] dimens: Increase quick_qs_total_height to 224dp for
 clean notification clearance

Change-Id: I014ea991638f38a52c560b525c5d9023e431f346
---
 core/res/res/values/dimens.xml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/res/res/values/dimens.xml b/core/res/res/values/dimens.xml
index bf94ed35..7ea43500 100644
--- a/core/res/res/values/dimens.xml
+++ b/core/res/res/values/dimens.xml
@@ -39,8 +39,8 @@
     <dimen name="status_bar_height_landscape">@dimen/status_bar_height_portrait</dimen>
     <!-- Height of area above QQS where battery/time go -->
     <dimen name="quick_qs_offset_height">48dp</dimen>
-    <!-- Total height of QQS (quick_qs_offset_height + 148) -->
-    <dimen name="quick_qs_total_height">196dp</dimen>
+    <!-- Total height of QQS (quick_qs_offset_height + 176) -->
+    <dimen name="quick_qs_total_height">224dp</dimen>
     <!-- Height of the bottom navigation / system bar. -->
     <dimen name="navigation_bar_height">48dp</dimen>
     <!-- Height of the bottom navigation bar in portrait; often the same as @dimen/navigation_bar_height -->
