From 3667029c1869b2453952407115f1e26a43fdd205 Mon Sep 17 00:00:00 2001
From: kake <kake@build.local>
Date: Tue, 25 Aug 2026 07:19:45 +0000
Subject: [PATCH 19/33] SystemUI: Hide footer drag handle in Half QS and add
 24dp notification clearance

Change-Id: I5e9006880d4f0fdfbe00e0cb0ecae91dc2af173c
---
 .../plugin/src/com/android/systemui/plugins/qs/QS.java       | 3 +++
 packages/SystemUI/res/values/dimens.xml                      | 2 +-
 .../SystemUI/src/com/android/systemui/qs/QSAnimator.java     | 4 ++++
 .../SystemUI/src/com/android/systemui/qs/QSFragment.java     | 5 +++++
 4 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/plugin/src/com/android/systemui/plugins/qs/QS.java b/packages/SystemUI/plugin/src/com/android/systemui/plugins/qs/QS.java
index 85a9fec8..d41801e6 100644
--- a/packages/SystemUI/plugin/src/com/android/systemui/plugins/qs/QS.java
+++ b/packages/SystemUI/plugin/src/com/android/systemui/plugins/qs/QS.java
@@ -62,6 +62,9 @@ public interface QS extends FragmentBase {
     void setExpandClickListener(OnClickListener onClickListener);
 
     View getHeader();
+    default View getFooter() {
+        return null;
+    }
 
     default void setHasNotifications(boolean hasNotifications) {
     }
diff --git a/packages/SystemUI/res/values/dimens.xml b/packages/SystemUI/res/values/dimens.xml
index 96f02fb1..e5238802 100644
--- a/packages/SystemUI/res/values/dimens.xml
+++ b/packages/SystemUI/res/values/dimens.xml
@@ -364,7 +364,7 @@
     <dimen name="qs_footer_icon_padding">14dp</dimen>
 
     <!-- The padding between the notifications and the quick settings container -->
-    <dimen name="qs_notification_padding">@dimen/notification_side_paddings</dimen>
+    <dimen name="qs_notification_padding">24dp</dimen>
 
     <!-- Height of the status bar header bar when expanded -->
     <dimen name="status_bar_header_height_expanded">124dp</dimen>
diff --git a/packages/SystemUI/src/com/android/systemui/qs/QSAnimator.java b/packages/SystemUI/src/com/android/systemui/qs/QSAnimator.java
index 1c39bbaf..bcdce86e 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/QSAnimator.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/QSAnimator.java
@@ -235,6 +235,10 @@ public class QSAnimator implements Callback, PageListener, Listener, OnLayoutCha
             firstPageBuilder.addFloat(mQsPanel.getFooter().getView(), "alpha", 0, 1);
             mAllViews.add(mQsPanel.getFooter().getView());
         }
+        if (mQs != null && mQs.getFooter() != null) {
+            firstPageBuilder.addFloat(mQs.getFooter(), "alpha", 0, 1);
+            mAllViews.add(mQs.getFooter());
+        }
 
         mFirstPageAnimator = firstPageBuilder
                 .setListener(this)
diff --git a/packages/SystemUI/src/com/android/systemui/qs/QSFragment.java b/packages/SystemUI/src/com/android/systemui/qs/QSFragment.java
index 0a3b43a7..3046dc6b 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/QSFragment.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/QSFragment.java
@@ -493,6 +493,11 @@ public class QSFragment extends LifecycleFragment implements QS, CommandQueue.Ca
         return mHeader.getHeight();
     }
 
+    @Override
+    public View getFooter() {
+        return mFooter;
+    }
+
     @Override
     public void hideImmediately() {
         getView().animate().cancel();
-- 
