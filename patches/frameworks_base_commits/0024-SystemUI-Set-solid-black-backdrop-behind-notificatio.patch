From 4d6454af6248609c833ec80f848a8cf6acbacc4a Mon Sep 17 00:00:00 2001
From: kake <kake@build.local>
Date: Tue, 25 Aug 2026 09:14:08 +0000
Subject: [PATCH 24/31] SystemUI: Set solid black backdrop behind notification
 shade and QS

Change-Id: I9411eef1fad3ed49a1471cc3489eb1b60e666f78
---
 .../systemui/statusbar/phone/ScrimController.java     | 11 ++++++++---
 .../android/systemui/statusbar/phone/ScrimState.java  |  2 +-
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
index 08ba5085..2a321400 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimController.java
@@ -111,7 +111,7 @@ public class ScrimController implements ViewTreeObserver.OnPreDrawListener, OnCo
      * A scrim varies its opacity based on a busyness factor, for example
      * how many notifications are currently visible.
      */
-    public static final float GRADIENT_SCRIM_ALPHA_BUSY = 0.7f;
+    public static final float GRADIENT_SCRIM_ALPHA_BUSY = 1.0f;
 
     /**
      * The most common scrim, the one under the keyguard.
@@ -454,7 +454,8 @@ public class ScrimController implements ViewTreeObserver.OnPreDrawListener, OnCo
             // Darken scrim as you pull down the shade when unlocked
             float behindFraction = getInterpolatedFraction();
             behindFraction = (float) Math.pow(behindFraction, 0.8f);
-            mCurrentBehindAlpha = behindFraction * GRADIENT_SCRIM_ALPHA_BUSY;
+            mCurrentBehindAlpha = behindFraction * 1.0f;
+            mCurrentBehindTint = Color.BLACK;
             mCurrentInFrontAlpha = 0;
         } else if (mState == ScrimState.KEYGUARD || mState == ScrimState.PULSING) {
             // Either darken of make the scrim transparent when you
@@ -763,7 +764,11 @@ public class ScrimController implements ViewTreeObserver.OnPreDrawListener, OnCo
         // At the end of the animation we need to remove the tint.
         if (mState == ScrimState.UNLOCKED) {
             mCurrentInFrontTint = Color.TRANSPARENT;
-            mCurrentBehindTint = Color.TRANSPARENT;
+            if (mExpansionFraction == 0.0f) {
+                mCurrentBehindTint = Color.TRANSPARENT;
+            } else {
+                mCurrentBehindTint = Color.BLACK;
+            }
         }
     }
 
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
index 5fa861c8..f6404389 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/phone/ScrimState.java
@@ -172,7 +172,7 @@ public enum ScrimState {
                 mBlankScreen = true;
             } else {
                 mCurrentInFrontTint = Color.TRANSPARENT;
-                mCurrentBehindTint = Color.TRANSPARENT;
+                mCurrentBehindTint = Color.BLACK;
                 mBlankScreen = false;
             }
         }
-- 
2.43.0

