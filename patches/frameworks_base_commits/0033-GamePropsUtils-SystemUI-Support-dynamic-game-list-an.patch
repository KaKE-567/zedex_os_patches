     public boolean onTouchEvent(MotionEvent event) {
-        if (android.provider.Settings.System.getInt(mContext.getContentResolver(), "gaming_mode_active", 0) == 1) {
+        if (android.provider.Settings.System.getInt(mContext.getContentResolver(), "gaming_mode_active", 0) == 1 &&
+            android.provider.Settings.System.getInt(mContext.getContentResolver(), "gaming_mode_lock_gestures", 1) == 1) {
