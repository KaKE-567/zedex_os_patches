+ * limitations under the License.
+ */
+
+package com.android.internal.util;
+
+import android.os.Build;
+import android.util.Log;
+
+import java.lang.reflect.Field;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public class GamePropsUtils {
+
+    private static final String TAG = "GamePropsUtils";
+    private static final boolean DEBUG = false;
+
+    private static final Map<String, Object> propsToChangeK30Ultra;
+
+    // Packages to spoof for PUBG/BGMI 90 FPS and HDR graphics
+    private static final List<String> packagesToSpoofPUBG = Arrays.asList(
+        "com.pubg.imobile",         // BGMI (Battlegrounds Mobile India)
+        "com.tencent.ig",           // PUBG Mobile (Global)
+        "com.pubg.krmobile",        // PUBG Mobile (Korea/Japan)
+        "com.vng.pubgmobile",       // PUBG Mobile (Vietnam)
+        "com.rekoo.pubgm",          // PUBG Mobile (Taiwan)
+        "com.tencent.tmgp.pubgmhd", // PUBG Mobile (HD / China)
+        "com.tencent.iglite",       // PUBG Mobile Lite
+        "com.activision.callofduty.shooter", // Call of Duty: Mobile
+        "com.garena.game.codm"      // CODM Garena
+    );
+
+    static {
+        propsToChangeK30Ultra = new HashMap<>();
+        propsToChangeK30Ultra.put("BRAND", "Xiaomi");
+        propsToChangeK30Ultra.put("MANUFACTURER", "Xiaomi");
+        propsToChangeK30Ultra.put("DEVICE", "cezanne");
+        propsToChangeK30Ultra.put("PRODUCT", "cezanne");
+        propsToChangeK30Ultra.put("MODEL", "M2006J10C");
+    }
+
+    public static boolean isGamePackage(String packageName) {
+        return packageName != null && packagesToSpoofPUBG.contains(packageName);
+    }
+
+    public static void setProps(String packageName) {
+        if (packageName == null || packageName.isEmpty()) {
+            return;
+        }
+
+        if (packagesToSpoofPUBG.contains(packageName)) {
+            if (DEBUG) Log.d(TAG, "Spoofing " + packageName + " as Xiaomi Redmi K30 Ultra (M2006J10C) for 90 FPS + HDR");
+            for (Map.Entry<String, Object> prop : propsToChangeK30Ultra.entrySet()) {
+                setPropValue(prop.getKey(), prop.getValue());
+            }
+        }
+    }
+
+    private static void setPropValue(String key, Object value) {
+        try {
+            if (DEBUG) Log.d(TAG, "Setting prop " + key + " to " + value.toString());
+            Field field = Build.class.getDeclaredField(key);
+            field.setAccessible(true);
+            field.set(null, value);
+            field.setAccessible(false);
+        } catch (NoSuchFieldException | IllegalAccessException e) {
+            Log.e(TAG, "Failed to set prop " + key, e);
+        }
+    }
+}
